# Cloak Environment Configuration Example
# NEVER commit production secrets to version control.

# Environment mode: development | test | production
# Production mode refuses to boot with in-memory fallback or default dev secrets.
CLOAK_ENV=development

# HTTP / WebSocket Server
API_HOST=127.0.0.1
API_PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# HMAC/EdDSA signing secret for short-lived session JWTs (generate >= 32 random bytes in production)
SESSION_JWT_SECRET=dev-only-insecure-session-secret-change-in-production-min-32-bytes

# PostgreSQL (required in all environments)
DATABASE_URL=postgres://cloak:cloak_dev_pass_2026@127.0.0.1:55432/cloak_dev
DATABASE_MAX_CONNECTIONS=20

# Redis (required in production; set CLOAK_DEV_ALLOW_IN_MEMORY_REDIS=true ONLY for local Dockerless dev)
REDIS_URL=redis://127.0.0.1:6379
CLOAK_DEV_ALLOW_IN_MEMORY_REDIS=false

# Object Storage (s3 | local; local is permitted ONLY when CLOAK_ENV != production)
OBJECT_STORE_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cloak-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
LOCAL_OBJECT_STORE_DIR=.cloak-dev/objects

# LiveKit SFU
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_must_be_at_least_32_characters_long_for_livekit

# Rate Limits & Resource Quotas
RATE_LIMIT_MSG_BURST=20
RATE_LIMIT_MSG_PER_MIN=120
RATE_LIMIT_EDIT_DELETE_PER_MIN=30
RATE_LIMIT_JOIN_PER_MIN=10
RATE_LIMIT_ROOM_CREATE_PER_HOUR=5
RATE_LIMIT_CALL_PER_MIN=5
RATE_LIMIT_PARALLEL_UPLOADS=3
MAX_ATTACHMENT_BYTES=26214400
ROOM_QUOTA_BYTES=536870912
WS_MAX_PAYLOAD_BYTES=65536
DEFAULT_MESSAGE_RETENTION_CHECK_SECS=15

# Frontend (Vite build-time / dev env)
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_WS_BASE_URL=ws://127.0.0.1:8080
VITE_LIVEKIT_URL=ws://127.0.0.1:7880
