:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080
	}

	@rtc path /rtc*
	handle @rtc {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy web:80
	}
}

